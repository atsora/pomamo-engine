<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
  namespace="Lemoine.GDBPersistentClasses"
  assembly="Pulse.Database">
  <class name="Doc" table="doc">
    <id name="Id" column="docid"
        access="nosetter.camelcase-m-underscore">
      <generator class="native">
        <param name="sequence">doc_docid_seq</param>
      </generator>
    </id>
    <version name="Version" column="docversion"
             access="nosetter.camelcase-m-underscore" />
    <property name="Path" column="docpath" not-null="true" />
    <property name="Tags" column="doctags" not-null="true"
              type="Lemoine.NHibernateTypes.StringListAsTextArrayType, Lemoine.Database" />
    <!-- lazy="false": the kind is read with the doc, so that it can be used once the
         session is closed (GraphQL schemas with a session per resolver) -->
    <many-to-one name="Kind" column="dockindid"
                 class="DocKind"
                 cascade="none"
                 lazy="false" fetch="join"
                 not-null="false"
                 not-found="ignore" />
  </class>
</hibernate-mapping>
